# PawaPay mobile-money payment (server-side only — never exposed to the browser)
#
# Copy this file to .env.local and fill in the values.

# Bearer token from your PawaPay dashboard (sandbox or production).
PAWAPAY_API_TOKEN=

# API base URL. Sandbox by default; switch to https://api.pawapay.io for live.
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# USD -> local currency conversion rates, as JSON. A country is only offered for
# payment if its currency has a rate here. Keep these updated.
PAWAPAY_USD_RATES={"ZMW":27,"KES":129,"TZS":2600,"UGX":3800,"RWF":1400,"GHS":15,"XOF":600,"XAF":600,"CDF":2800,"MWK":1700,"NGN":1600}

# Shown on the payer's mobile-money statement (max 22 alphanumeric chars).
PAWAPAY_STATEMENT_DESCRIPTION=CBFF SME 2026
